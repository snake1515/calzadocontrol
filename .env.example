# Copia este archivo como .env para trabajar en tu PC
SECRET_KEY=cambia-esto-por-una-clave-larga
# Supabase > Project Settings > Database > Connection string (URI, Session pooler)
DATABASE_URL=postgresql://postgres.xxxx:TU_CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Usuario SoftGest (crea y administra las empresas en /softgest)
SUPERADMIN_USER=softgest
SUPERADMIN_PASSWORD=cambia-esta-clave
# WhatsApp al que escriben los clientes para activar su plan (con indicativo 57)
SOFTGEST_WHATSAPP=573001234567
NOMBRE_NEGOCIO=CalzadoControl
